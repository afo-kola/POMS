  "scripts": {
    "clean-tests": "rm -rf ./compiled_tests",
    "copy:mocks": "./node_modules/.bin/mkdirp ./compiled_tests/tests/mockResponse && cp ./tests/mockResponse/*.json ./compiled_tests/tests/mockResponse",
    "copy:data": "./node_modules/.bin/mkdirp ./compiled_tests/tests/component/data && cp -r ./tests/component/data/* ./compiled_tests/tests/component/data",
    "compile-tests": "yarn run clean-tests && ./node_modules/.bin/tsc -p tests-tsconfig.json && yarn run copy:mocks && yarn run copy:data",
    "unit-test": "NODE_ENV=test node ./tests/unit-jasmine.runner.js",
    "coverage": "./node_modules/.bin/istanbul cover ./tests/unit-jasmine.runner.js && node ./config/coverage.runner.js",
    "run-tests": "yarn run compile-tests && yarn run coverage",
    "test": "yarn run run-tests",
    "lint": "echo \"Need to apply linting. No old repos has maintained lint correctly\"",
    "build": "serverless webpack --stage=dev --config serverless.yml",
    "deploy:dev": "serverless deploy --stage=dev --config serverless.yml"
  },
